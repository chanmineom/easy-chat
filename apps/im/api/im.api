syntax = "v1"

type (
	SyncMessage {
		MessageId       string `json:"message_id"`
		ConversationId  string `json:"conversation_id"`
		Sequence        int64  `json:"sequence"`
		SenderId        string `json:"sender_id"`
		ClientMessageId string `json:"client_message_id"`
		ContentType     string `json:"content_type"`
		Content         string `json:"content"`
		CreatedAt       int64  `json:"created_at"`
	}
	SyncMessagesReq {
		ConversationId string `form:"conversation_id"`
		AfterSeq       int64  `form:"after_seq,optional"`
		BeforeSeq      int64  `form:"before_seq,optional"`
		Limit          int32  `form:"limit,optional"`
	}
	SyncMessagesResp {
		List    []*SyncMessage `json:"list"`
		HasMore bool           `json:"has_more"`
	}
)

type (
	ConversationSummary {
		ConversationId string       `json:"conversation_id"`
		ChatType       int32        `json:"chat_type"`
		Title          string       `json:"title"`
		AvatarUrl      string       `json:"avatar_url"`
		PeerUserId     string       `json:"peer_user_id,omitempty"`
		LastSeq        int64        `json:"last_seq"`
		ReadSeq        int64        `json:"read_seq"`
		DeliveredSeq   int64        `json:"delivered_seq"`
		UnreadCount    int64        `json:"unread_count"`
		LastActivityAt int64        `json:"last_activity_at"`
		LastSenderName string       `json:"last_sender_name,optional"`
		LastMessage    *SyncMessage `json:"last_message,omitempty"`
	}
	ListConversationsReq {
		Limit                int32  `form:"limit,optional"`
		BeforeActivityAt     int64  `form:"before_activity_at,optional"`
		BeforeConversationId string `form:"before_conversation_id,optional`
	}
	ListConversationsResp {
		List    []*ConversationSummary `json:"list"`
		HasMore bool                   `json:"has_more"`
	}
)

type (
	IssueWSTicketReq {
		DeviceId string `json:"device_id"`
	}
	IssueWSTicketResp {
		Ticket    string `json:"ticket"`
		ExpiresAt int64  `json:"expires_at"`
	}
)

@server (
	prefix: v1/im
	group:  message
	jwt:    JwtAuth
)
service im {
	@doc "sync messages after a conversation sequence"
	@handler syncMessages
	get /messages (SyncMessagesReq) returns (SyncMessagesResp)

	@doc "list user conversations"
	@handler listConversations
	get /conversations (ListConversationsReq) returns (ListConversationsResp)

	@doc "issue one-time websocket ticket"
	@handler issueWSTicket
	post /ws/ticket (IssueWSTicketReq) returns (IssueWSTicketResp)
}

