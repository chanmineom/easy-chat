# Infrastructure
MYSQL_DSN='user:password@tcp(192.168.64.2:3306)/easy-chat?charset=utf8mb4&parseTime=true&loc=UTC'
MONGO_URL='mongodb://admin:password@host:27017/easy-chat?authSource=admin&replicaSet=rs0'
MONGO_DB=easy-chat
REDIS_HOST=192.168.64.2:6379
KAFKA_BROKER=192.168.64.2:9092
ETCD_HOST=192.168.64.2:2379

# Security
JWT_ACCESS_SECRET=change-me
INTERNAL_AUTH_KEY=easy-chat:rpc-auth

USER_API_RPC_TOKEN=change-me
SOCIAL_API_RPC_TOKEN=change-me
IM_API_RPC_TOKEN=change-me
TASK_RPC_TOKEN=change-me
SOCIAL_RPC_TOKEN=change-me

# RPC endpoints
USER_RPC_ADDR=127.0.0.1:8083
SOCIAL_RPC_ADDR=127.0.0.1:8081
IM_RPC_ADDR=127.0.0.1:8080

# WebSocket discovery
WS_ETCD_KEY_PREFIX=/easy-chat/ws.rpc/
